{
  "name": "cascade-backend-server",
  "version": "1.0.0",
  "description": "Node.js + TypeScript Orchestration Server for Team Cascade (Expo Go Ready)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && node scripts/copy-db-schema.js",
    "start": "node dist/index.js",
    "test": "ts-node ../evaluation/benchmark.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cascade-hackathon-monorepo": "file:..",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
